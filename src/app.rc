#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC -1
#endif

IDD_MAIN DIALOGEX 0, 0, 420, 310
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fallout: Crossroads"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Fallout: Crossroads",IDC_TITLE,12,10,396,12
    LTEXT           "Unofficial fan project. BYO legal Fallout 3 + New Vegas installs only.",IDC_STATIC,12,24,396,10

    GROUPBOX        "Fallout 3 (1.7.0.3-class)",IDC_STATIC,12,40,396,48
