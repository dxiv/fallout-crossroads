    PUSHBUTTON      "Save settings",IDC_SAVE,12,274,70,18
    PUSHBUTTON      "Re-check",IDC_RECHECK,86,274,60,18
    PUSHBUTTON      "Legal",IDC_LEGAL,150,274,50,18
    PUSHBUTTON      "Credits",IDC_CREDITS,204,274,50,18
    DEFPUSHBUTTON   "Launch",IDC_CONTINUE,286,274,60,18
